[Unit]
Description=Tech Arcade Console Launcher (Modo Kiosk)
After=systemd-user-sessions.service sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Tads-Station-Tech-Console-Games-Raspberry/rpi-console
ExecStart=/usr/bin/xinit /usr/bin/python3 /home/pi/Tads-Station-Tech-Console-Games-Raspberry/rpi-console/main.py -- :0 vt1 -nocursor
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
